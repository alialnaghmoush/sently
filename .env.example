# Copy to `.env` and fill in values you need.
# Bun loads `.env` automatically. Never commit real secrets.

# ─── Live tests (tests/integration/*.live.test.ts) ───────
# Opt-in only. `bun run verify` never runs *.live.test.ts (ignored + LIVE flags cleared).
# Exported shell vars override this file — use `unset TAQNYAT_LIVE` or prefix the command.
# SNDR — SNDR_LIVE=1 bun run test:live
#   or: SNDR_LIVE=1 bun test tests/integration/sndr.live.test.ts
SNDR_LIVE=
SNDR_API_KEY=
SNDR_FROM=
SNDR_TO=

# Taqnyat — TAQNYAT_LIVE=1 bun run test:live
#   or: TAQNYAT_LIVE=1 bun test tests/integration/taqnyat.live.test.ts
# Free preflight (balance / approved WA template) runs before each paid send.
TAQNYAT_LIVE=
TAQNYAT_TO=
TAQNYAT_MAIL_FROM=
TAQNYAT_MAIL_TO=
TAQNYAT_MAIL_CAMPAIGN=
TAQNYAT_WHATSAPP_TO=
TAQNYAT_WHATSAPP_TEMPLATE=
TAQNYAT_WHATSAPP_TEMPLATE_LANG=

# ─── Email transports ───────────────────────────────────
# Resend — sently/transports/resend
RESEND_API_KEY=

# SNDR — sently/transports/sndr
# (see Live tests above)

# SendGrid — sently/transports/sendgrid
SENDGRID_API_KEY=

# Postmark — sently/transports/postmark
POSTMARK_TOKEN=

# Mailgun — sently/transports/mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Amazon SES — sently/transports/ses
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# AWS_SESSION_TOKEN=

# Brevo — sently/transports/brevo
BREVO_API_KEY=

# MailerSend — sently/transports/mailersend
MAILERSEND_API_TOKEN=

# Plunk — sently/transports/plunk
PLUNK_API_KEY=

# SparkPost — sently/transports/sparkpost
SPARKPOST_API_KEY=

# Mailtrap — sently/transports/mailtrap
MAILTRAP_API_TOKEN=

# Loops — sently/transports/loops
LOOPS_API_KEY=

# Taqnyat Email — sently/transports/taqnyat-mail
# (live recipients / campaign: see Live tests above)
TAQNYAT_MAIL_TOKEN=

# SMTP (createSMTPMailer / sently/smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Mailpit (local catcher) — sently/transports/mailpit
# Defaults: SMTP localhost:1025, UI/API http://localhost:8025
# MAILPIT_API_URL=http://localhost:8025

# Inbucket (local catcher) — sently/transports/inbucket
# Defaults: SMTP localhost:2500, UI/API http://localhost:9000
# Opt-in live suite: INBUCKET_LIVE=1 bun run test:live
# INBUCKET_LIVE=1
# INBUCKET_API_URL=http://localhost:9000
# INBUCKET_SMTP_HOST=localhost
# INBUCKET_SMTP_PORT=2500

# ─── SMS transports ─────────────────────────────────────
# Twilio — sently/transports/twilio-sms
TWILIO_ACCOUNT_SID=
# Production: API Key SID + Secret (auth username/password)
TWILIO_API_KEY=
TWILIO_API_KEY_SECRET=
# Local testing alternative: use Account SID + Auth Token as username/password
# TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Taqnyat SMS — sently/transports/taqnyat-sms
# (live recipient: TAQNYAT_TO — see Live tests above)
TAQNYAT_TOKEN=
TAQNYAT_SENDER=

# Msegat — sently/transports/msegat
MSEGAT_USERNAME=
MSEGAT_API_KEY=
MSEGAT_SENDER=

# ─── WhatsApp transports ────────────────────────────────
# Meta WhatsApp Cloud — sently/transports/whatsapp-cloud
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Taqnyat WhatsApp — sently/transports/taqnyat-whatsapp
# (live recipient / template: see Live tests above)
TAQNYAT_WHATSAPP_TOKEN=

# ─── Push ───────────────────────────────────────────────
# Web Push — sently/transports/webpush (+ examples/webpush-interop)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Auth / DKIM ────────────────────────────────────────
# OAuth2 (Google) — sently/auth/oauth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# OAuth2 (Microsoft) — sently/auth/oauth2
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REFRESH_TOKEN=

# DKIM — sently/dkim (PEM private key; use \n for newlines in one line)
DKIM_PRIVATE_KEY=
DKIM_DOMAIN=
DKIM_SELECTOR=

# ─── Webhook signing secrets ────────────────────────────
# Resend (Svix) — verifyResendSignature / sently/webhooks/resend
RESEND_WEBHOOK_SECRET=

# Mailgun — verifyMailgunSignature / sently/webhooks/mailgun
MAILGUN_WEBHOOK_SIGNING_KEY=

# SNDR — verifySndrSignature / sently/webhooks/sndr
SNDR_WEBHOOK_SECRET=
