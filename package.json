{
  "name": "sently",
  "version": "0.10.0",
  "description": "Runtime-agnostic messaging library for Node.js, Bun, Deno, and Cloudflare Workers. Channel-first email, SMS, WhatsApp, and push with pluggable provider transports.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "site/content/docs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "workspaces": [
    "site"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check src",
    "format": "biome format src --write",
    "typecheck": "tsc --noEmit",
    "mcp": "bun tools/mcp/index.ts",
    "site:dev": "bun run --cwd site dev",
    "site:build": "bun run --cwd site build",
    "verify": "bun run lint && bun run typecheck && bun run build && bun run site:build && bun test",
    "prepack": "bun run verify",
    "pack:npm": "npm pack --dry-run --cache ./.npm-cache",
    "publish:npm-d": "npm publish --dry-run --cache ./.npm-cache",
    "publish:npm": "npm publish --cache ./.npm-cache",
    "publish:jsr-d": "npx jsr publish --dry-run",
    "publish:jsr": "npx jsr publish",
    "publish:all-d": "bun run publish:npm-d && bun run publish:jsr-d",
    "publish:all": "bun run publish:npm && bun run publish:jsr",
    "verify:publish": "bun run pack:npm",
    "measure:size": "bun tools/measure-bundle-size.ts",
    "measure:size:md": "bun tools/measure-bundle-size.ts --markdown",
    "check:size": "bun tools/measure-bundle-size.ts --check",
    "g": "gflows"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@react-email/render": "1.1.2",
    "gflows": "1.2.1",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "6.0.3"
  },
  "keywords": [
    "email",
    "smtp",
    "mailer",
    "nodemailer",
    "nodemailer-alternative",
    "bun",
    "deno",
    "cloudflare-workers",
    "edge",
    "runtime-agnostic",
    "resend",
    "sendgrid",
    "postmark",
    "mailgun",
    "ses",
    "aws-ses",
    "brevo",
    "dkim",
    "oauth2",
    "transactional-email",
    "esm",
    "zero-dependencies"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alialnaghmoush/sently.git"
  },
  "homepage": "https://github.com/alialnaghmoush/sently#readme",
  "bugs": {
    "url": "https://github.com/alialnaghmoush/sently/issues"
